{
  "name": "TacticHOL",
  "build": { "dockerfile": "Dockerfile" },
  "runArgs": ["--hostname=tactichol"],
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/vscode/hol-light/TacticHOL,type=bind,consistency=cached",
  "workspaceFolder": "/home/vscode/hol-light/TacticHOL",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": ["monadius.hol-light-simple"]
    }
  }
}
